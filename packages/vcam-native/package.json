{
  "name": "@omnicam/vcam-native",
  "version": "1.0.0",
  "private": true,
  "description": "Native virtual camera backend for OmniCam (N-API addon + DirectShow filter on Windows, v4l2loopback on Linux)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "register": "node scripts/register.mjs",
    "unregister": "node scripts/register.mjs -Unregister",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true});require('node:fs').rmSync('build-x86',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.3.0"
  }
}
