// Version resource for the OmniCam binaries, configured by CMakeLists.txt (omnicam_version_resource).
// The version comes from apps/desktop/package.json, like the installer's; code signing requires
// product name and version on every signed file.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @OMNICAM_VERSION_MAJOR@,@OMNICAM_VERSION_MINOR@,@OMNICAM_VERSION_PATCH@,0
 PRODUCTVERSION  @OMNICAM_VERSION_MAJOR@,@OMNICAM_VERSION_MINOR@,@OMNICAM_VERSION_PATCH@,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Orest Zogju"
      VALUE "FileDescription",  "@OMNICAM_FILE_DESCRIPTION@"
      VALUE "FileVersion",      "@OMNICAM_VERSION@"
      VALUE "InternalName",     "@OMNICAM_FILE_NAME@"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Orest-Z. MIT License."
      VALUE "OriginalFilename", "@OMNICAM_FILE_NAME@"
      VALUE "ProductName",      "OmniCam"
      VALUE "ProductVersion",   "@OMNICAM_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
